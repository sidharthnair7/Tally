# Copy this file to .env.local and fill in what you use. .env.local is gitignored: never commit keys.
# With nothing set, Tally runs offline: the same SQL on H2 over data/sources/, no keys needed.

# --- Live data: the four systems as Zetaris datasources (see zetaris/) ---
# TALLY_BACKEND=zetaris
# JDBC (recommended): the driver jar from the Zetaris bundle
# ZETARIS_JDBC_JAR=C:/zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
# ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# ZETARIS_USERNAME=
# ZETARIS_PASSWORD=
# PG_HOST=postgres
# PG_USER=
# PG_PASSWORD=
# Or REST:
# ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# ZETARIS_ORG_ID=1
# ZETARIS_API_KEY=
# ZETARIS_DS_ERP=tally_erp
# ZETARIS_DS_VENDORS=tally_vendors
# ZETARIS_DS_HR=tally_hr
# ZETARIS_DS_BANK=tally_bank

# --- Model for the explanations (optional; verdicts never depend on it) ---
# NVIDIA Nemotron on build.nvidia.com (any OpenAI-compatible endpoint works)
# TALLY_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# TALLY_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# TALLY_LLM_API_KEY=
# TALLY_LLM_LABEL=NVIDIA Nemotron
# Or Meterless Nightshift on your own machine (its AI hotspot is OpenAI-compatible):
# TALLY_LLM_BASE_URL=http://<your nightshift hotspot address>/v1

# --- Memory: the Meterless H-MEM sidecar in memory/ ---
# TALLY_MEMORY_URL=http://127.0.0.1:8787
